<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>KznStore</AssemblyName>
    <RootNamespace>KznStore</RootNamespace>
    <Version>1.0.0</Version>
    <Product>Kzn Store</Product>
    <Title>Kzn Store</Title>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\kzn-store.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="Assets\kzn-store.ico" />
  </ItemGroup>
</Project>
