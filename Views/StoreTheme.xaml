<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <SolidColorBrush x:Key="CanvasBrush" Color="#101216"/>
  <SolidColorBrush x:Key="SidebarBrush" Color="#15181D"/>
  <SolidColorBrush x:Key="SurfaceBrush" Color="#1D2026"/>
  <SolidColorBrush x:Key="ControlBrush" Color="#292D35"/>
  <SolidColorBrush x:Key="TextBrush" Color="#F5F5F7"/>
  <SolidColorBrush x:Key="MutedBrush" Color="#A3AAB7"/>
  <SolidColorBrush x:Key="AccentBrush" Color="#70B5FF"/>
  <SolidColorBrush x:Key="PrimaryActionBrush" Color="#0066D6"/>
  <SolidColorBrush x:Key="OnAccentBrush" Color="#FFFFFF"/>
  <SolidColorBrush x:Key="StrokeBrush" Color="#414752"/>
  <SolidColorBrush x:Key="DividerBrush" Color="#343A44"/>
  <SolidColorBrush x:Key="HoverBrush" Color="#252B35"/>
  <SolidColorBrush x:Key="SelectionWashBrush" Color="#17345C"/>
  <SolidColorBrush x:Key="NavIconBrush" Color="#292F39"/>
  <SolidColorBrush x:Key="NavIconForegroundBrush" Color="#D1D7E0"/>
  <SolidColorBrush x:Key="NavSelectedBrush" Color="#174A87"/>
  <SolidColorBrush x:Key="NavSelectedTextBrush" Color="#FFFFFF"/>
  <SolidColorBrush x:Key="BrandTileBrush" Color="#34343A"/>
  <SolidColorBrush x:Key="BrandMarkBrush" Color="#FFFFFF"/>
  <SolidColorBrush x:Key="PreviewBrush" Color="#252D3A"/>
  <SolidColorBrush x:Key="TrackBrush" Color="#555D6B"/>
  <Style TargetType="TextBlock"><Setter Property="TextOptions.TextFormattingMode" Value="Display"/><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/></Style>
  <Style TargetType="ComboBox"><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/><Setter Property="Background" Value="{DynamicResource ControlBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource StrokeBrush}"/><Setter Property="Padding" Value="9,5"/><Setter Property="MinHeight" Value="34"/></Style>
  <Style TargetType="ScrollBar"><Setter Property="Width" Value="12"/><Setter Property="Background" Value="Transparent"/></Style>
</ResourceDictionary>
